APP_ENV=development
PORT=8080

# IANA zone that defines a calendar "day" for check-in rules (first-of-day
# bonus, one check-in per place per day). In UTC the day would roll over at
# 7pm local — mid-evening for a nightlife app.
APP_TIMEZONE=America/Bogota

POSTGRES_USER=candela_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=candela_db

REDIS_PASSWORD=change_me

# Required when APP_ENV=production: the server refuses to start without it, or
# with fewer than 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change_me_32_chars_minimum

# OAuth client ID (type "Web application") from Google Cloud Console.
# Must match the serverClientId configured in candela_front/lib/config.dart.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=candela-photos
STORAGE_USE_SSL=false
