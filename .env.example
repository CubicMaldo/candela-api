APP_ENV=development
PORT=8080

POSTGRES_USER=candela_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=candela_db

REDIS_PASSWORD=change_me

JWT_SECRET=change_me_32_chars_minimum

# OAuth client ID (type "Web application") from Google Cloud Console.
# Must match the serverClientId configured in candela_front/lib/config.dart.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=candela-photos
STORAGE_USE_SSL=false
